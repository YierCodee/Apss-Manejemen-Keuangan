// NevBank - Financial Management for Students
// Prisma schema disinkronkan dengan SQL migration (supabase/migrations/)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUM TYPES (sesuai SQL enum values)
// ============================================

enum Role {
  super_admin   @map("super_admin")
  bendahara     @map("bendahara")
  operasional   @map("operasional")
  pemasaran     @map("pemasaran")
  member        @map("member")

  @@map("Role")
}

enum TransactionType {
  pemasukan    @map("pemasukan")
  pengeluaran  @map("pengeluaran")

  @@map("TransactionType")
}

enum RabProjectStatus {
  draft      @map("draft")
  active     @map("active")
  completed  @map("completed")

  @@map("RabProjectStatus")
}

enum RabPriority {
  on_track  @map("on-track")
  high      @map("high")
  medium    @map("medium")
  low       @map("low")

  @@map("RabPriority")
}

enum RabItemStatus {
  on_track     @map("on-track")
  warning      @map("warning")
  over_budget  @map("over-budget")

  @@map("RabItemStatus")
}

enum CashFlowType {
  inflow   @map("inflow")
  outflow  @map("outflow")

  @@map("CashFlowType")
}

enum AssetStatus {
  active     @map("active")
  sold       @map("sold")
  disposed   @map("disposed")

  @@map("AssetStatus")
}

enum AuditAction {
  create  @map("create")
  update  @map("update")
  delete  @map("delete")

  @@map("AuditAction")
}

// ============================================
// USER MANAGEMENT
// ============================================

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  password  String?  @db.VarChar(255)
  role      Role
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts            Account[]
  transactions        Transaction[]
  rabProjects         RabProject[]     @relation("RabProjectCreator")
  rabProjectsUpdated  RabProject[]     @relation("RabProjectUpdater")
  products            Product[]
  productsUpdated     Product[]        @relation("ProductUpdater")
  stockCreated        Stock[]          @relation("StockCreator")
  stockUpdated        Stock[]          @relation("StockUpdater")
  salesTransactions   SalesTransaction[]
  cashFlows           CashFlow[]
  assetsCreated       Asset[]          @relation("AssetCreator")
  assetsUpdated       Asset[]          @relation("AssetUpdater")
  auditLogs           AuditLog[]

  @@map("users")
}

// ============================================
// REKENING & AKUN
// ============================================

model Account {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  name          String   @db.VarChar(255)
  type          String   @default("PRIMARY") @db.VarChar(50)
  bank          String?  @db.VarChar(100)
  accountNumber String?  @map("account_number") @db.VarChar(50)
  balance       Decimal  @default(0) @db.Decimal(15, 2)
  currency      String   @default("IDR") @db.VarChar(10)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

// ============================================
// MASTER DATA - KATEGORI
// ============================================

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(50)
  emoji     String?  @db.VarChar(10)
  color     String?  @db.VarChar(20)
  bgColor   String?  @map("bg_color") @db.VarChar(20)
  type      String   @default("PENGELUARAN") @db.VarChar(20)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  transactions Transaction[]
  rabItems     RabItem[]

  @@map("categories")
}

// ============================================
// MASTER DATA - METODE PEMBAYARAN
// ============================================

model PaymentMethod {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  type      String   @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("payment_methods")
}

// ============================================
// TRANSAKSI KEUANGAN (Data Pribadi)
// ============================================

model Transaction {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  name          String   @db.VarChar(255)
  type          TransactionType
  category      String?  @db.Uuid   // FK ke categories.id
  accountName   String?  @map("account_name") @db.VarChar(100)
  quantity      Int      @default(1)
  price         Decimal  @db.Decimal(12, 2)
  totalAmount   Decimal  @map("total_amount") @db.Decimal(12, 2)
  paymentMethod String   @map("payment_method") @db.VarChar(50)
  date          DateTime @db.Date
  time          DateTime @db.Time(6)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryRef Category? @relation(fields: [category], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@map("transactions")
}

// ============================================
// RAB PROJECTS (Data Bisnis Kelompok)
// ============================================

model RabProject {
  id                String           @id @default(uuid()) @db.Uuid
  projectName       String           @map("project_name") @db.VarChar(255)
  quarter           String           @db.VarChar(20)
  year              Int
  totalBudget       Decimal          @map("total_budget") @db.Decimal(15, 2)
  totalRealization  Decimal          @default(0) @map("total_realization") @db.Decimal(15, 2)
  status            RabProjectStatus @default(draft)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  deletedAt         DateTime?        @map("deleted_at")
  createdBy         String           @map("created_by") @db.Uuid
  updatedBy         String?          @map("updated_by") @db.Uuid

  creator  User   @relation("RabProjectCreator", fields: [createdBy], references: [id])
  updater  User?  @relation("RabProjectUpdater", fields: [updatedBy], references: [id])
  items    RabItem[]

  @@index([year, quarter])
  @@map("rab_projects")
}

// ============================================
// RAB ITEMS
// ============================================

model RabItem {
  id              String        @id @default(uuid()) @db.Uuid
  rabProjectId    String        @map("rab_project_id") @db.Uuid
  name            String        @db.VarChar(255)
  specs           String?       @db.Text          // Rincian spesifikasi / sub-item
  category        String?       @db.Uuid  // FK ke categories.id
  categoryRef     Category?     @relation(fields: [category], references: [id], onDelete: SetNull)
  priority        RabPriority
  quantity        Int
  pricePerUnit    Decimal       @map("price_per_unit") @db.Decimal(12, 2)
  totalBudget     Decimal       @map("total_budget") @db.Decimal(12, 2)
  realization     Decimal       @default(0) @db.Decimal(12, 2)
  targetProgress  Int           @default(0) @map("target_progress")
  notes           String?       @db.Text          // Catatan tambahan & sumber kas
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  project RabProject @relation(fields: [rabProjectId], references: [id], onDelete: Cascade)

  @@index([rabProjectId])
  @@map("rab_items")
}

// ============================================
// BISNIS KELOMPOK - PRODUK
// ============================================

model Product {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(255)
  description String?   @db.Text
  category    String    @db.VarChar(100)
  price       Decimal   @db.Decimal(12, 2)
  cost        Decimal   @db.Decimal(12, 2)
  sku         String    @unique @db.VarChar(50)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String    @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid

  creator           User               @relation(fields: [createdBy], references: [id])
  updater           User?              @relation("ProductUpdater", fields: [updatedBy], references: [id])
  stock             Stock[]
  salesTransactions SalesTransaction[]

  @@map("products")
}

// ============================================
// STOK
// ============================================

model Stock {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  quantity    Int
  minStock    Int       @default(0) @map("min_stock")
  maxStock    Int?      @map("max_stock")
  lastRestock DateTime? @map("last_restock")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String    @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  creator User    @relation("StockCreator", fields: [createdBy], references: [id])
  updater User?   @relation("StockUpdater", fields: [updatedBy], references: [id])

  @@index([productId])
  @@map("stock")
}

// ============================================
// TRANSAKSI PENJUALAN
// ============================================

model SalesTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  quantity      Int
  unitPrice     Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalAmount   Decimal  @map("total_amount") @db.Decimal(12, 2)
  paymentMethod String   @map("payment_method") @db.VarChar(50)
  customerName  String?  @map("customer_name") @db.VarChar(255)
  date          DateTime @db.Date
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")
  createdBy     String   @map("created_by") @db.Uuid

  product Product @relation(fields: [productId], references: [id])
  creator User    @relation(fields: [createdBy], references: [id])

  @@index([date])
  @@index([productId])
  @@map("sales_transactions")
}

// ============================================
// CASH FLOW
// ============================================

model CashFlow {
  id            String       @id @default(uuid()) @db.Uuid
  type          CashFlowType
  category      String       @db.VarChar(100)
  amount        Decimal      @db.Decimal(12, 2)
  description   String?      @db.Text
  referenceId   String?      @map("reference_id") @db.Uuid
  referenceType String?      @map("reference_type") @db.VarChar(50)
  date          DateTime     @db.Date
  createdAt     DateTime     @default(now()) @map("created_at")
  deletedAt     DateTime?    @map("deleted_at")
  createdBy     String       @map("created_by") @db.Uuid

  creator User @relation(fields: [createdBy], references: [id])

  @@index([date])
  @@map("cash_flow")
}

// ============================================
// ASET
// ============================================

model Asset {
  id               String      @id @default(uuid()) @db.Uuid
  name             String      @db.VarChar(255)
  category         String      @db.VarChar(100)
  purchasePrice    Decimal     @map("purchase_price") @db.Decimal(15, 2)
  currentValue     Decimal     @map("current_value") @db.Decimal(15, 2)
  purchaseDate     DateTime    @map("purchase_date") @db.Date
  depreciationRate Decimal     @default(0) @map("depreciation_rate") @db.Decimal(5, 2)
  status           AssetStatus @default(active)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  deletedAt        DateTime?   @map("deleted_at")
  createdBy        String      @map("created_by") @db.Uuid
  updatedBy        String?     @map("updated_by") @db.Uuid

  creator User  @relation("AssetCreator", fields: [createdBy], references: [id])
  updater User? @relation("AssetUpdater", fields: [updatedBy], references: [id])

  @@map("assets")
}

// ============================================
// AUDIT LOGS
// ============================================

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  actorId   String      @map("actor_id") @db.Uuid
  action    AuditAction
  tableName String      @map("table_name") @db.VarChar(100)
  recordId  String      @map("record_id") @db.Uuid
  oldData   Json?       @map("old_data")
  newData   Json?       @map("new_data")
  createdAt DateTime    @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id])

  @@index([tableName, recordId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
